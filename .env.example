# Solana RPC endpoint (example: Helius, QuickNode, Alchemy)
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY_HERE

# Optional: if using providers that require a separate API key
HELIUS_API_KEY=YOUR_API_KEY_HERE

# SPL token mint address to analyze
MINT_ADDRESS=So11111111111111111111111111111111111111112

# Number of top holders to scan
TOP_N=20
